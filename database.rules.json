{
  "rules": {
    ".read": false,
    ".write": false,

    "estadisticas":         { ".read": "auth != null", ".write": "auth != null" },
    "estadisticas_modulos": { ".read": "auth != null", ".write": "auth != null" },
    "alertas":              { ".read": "auth != null", ".write": "auth != null" },
    "sistema":              { ".read": "auth != null", ".write": "auth != null" },
    "accesos_temporales":   { ".read": "auth != null", ".write": "auth != null" },
    "actividad_reciente":   { ".read": "auth != null", ".write": "auth != null" },

    "bienestar": {
      "senales": { ".read": "auth != null", ".write": true }
    },

    "presencia": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['usuario','online','ultimo_ping'])",
        "usuario":     { ".validate": "newData.isString() && newData.val().length < 60" },
        "nombre":      { ".validate": "newData.isString() && newData.val().length < 120" },
        "rol":         { ".validate": "newData.isString() && newData.val().length < 60" },
        "empresa":     { ".validate": "newData.isString() && newData.val().length < 40" },
        "modulo":      { ".validate": "newData.isString() && newData.val().length < 80" },
        "pagina":      { ".validate": "newData.isString() && newData.val().length < 80" },
        "online":      { ".validate": "newData.isBoolean()" },
        "ultimo_ping": { ".validate": "newData.isNumber()" },
        "$otros":      { ".validate": false }
      }
    },

    "mensajes": {
      ".read": true,
      "$uid": {
        "$msgId": {
          ".write": true,
          ".validate": "newData.hasChildren(['texto'])",
          "texto":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 1000" },
          "de":         { ".validate": "newData.isString() && newData.val().length < 120" },
          "de_usuario": { ".validate": "newData.isString() && newData.val().length < 60" },
          "ts":         { ".validate": "newData.isNumber()" },
          "leido":      { ".validate": "newData.isBoolean()" },
          "leido_ts":   { ".validate": "newData.isNumber()" },
          "$otros":     { ".validate": false }
        }
      }
    },

    "trafico": {
      ".read": true,
      "$id": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['ts','u','sis','accion','destino'])",
        "ts":      { ".validate": "newData.isNumber()" },
        "u":       { ".validate": "newData.isString() && newData.val().length < 60" },
        "n":       { ".validate": "newData.isString() && newData.val().length < 120" },
        "rol":     { ".validate": "newData.isString() && newData.val().length < 40" },
        "sis":     { ".validate": "newData.isString() && newData.val().length < 40" },
        "accion":  { ".validate": "newData.isString() && newData.val().length < 80" },
        "destino": { ".validate": "newData.isString() && newData.val().length < 40" },
        "detalle": { ".validate": "newData.isString() && newData.val().length < 160" },
        "tipo":    { ".validate": "newData.isString() && newData.val().length < 12" },
        "$otros":  { ".validate": false }
      }
    },

    "historial": {
      ".read": true,
      "$uid": {
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['ts','evento'])",
          "ts":      { ".validate": "newData.isNumber()" },
          "evento":  { ".validate": "newData.isString() && newData.val().length < 30" },
          "pagina":  { ".validate": "newData.isString() && newData.val().length < 80" },
          "modulo":  { ".validate": "newData.isString() && newData.val().length < 80" },
          "$otros":  { ".validate": false }
        }
      }
    }
  }
}
